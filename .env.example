# API Configuration
VITE_BASE_API_URL=https://centrixg.onrender.com/api

VITE_APP_TARGET=web
VITE_ENABLE_WEB=true
VITE_ENABLE_DESKTOP=true

# SePay Payment Gateway & Webhook Configuration
VITE_SEPAY_BANK_CODE=MBBank
VITE_SEPAY_BANK_NAME=MB Bank (Ngân hàng Quân Đội)
VITE_SEPAY_ACC_NUMBER=
VITE_SEPAY_ACC_NAME=
VITE_SEPAY_TEMPLATE=compact
VITE_SEPAY_ORDER_PREFIX=CG
VITE_SEPAY_TIMEOUT_SECONDS=900

# SePay Webhook & API Keys (Strictly defined in deployment environment settings)
VITE_SEPAY_API_KEY=
VITE_SEPAY_WEBHOOK_SECRET=
VITE_SEPAY_API_URL=https://my.sepay.vn/userapi
VITE_SEPAY_WEBHOOK_URL=https://centrixg.onrender.com/api/payment/sepay-webhook
VITE_SEPAY_POLL_INTERVAL_MS=3000
